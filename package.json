{
  "name": "cf-pr-preview-action",
  "version": "1.1.4",
  "private": true,
  "description": "GitHub Action for per-PR ephemeral Cloudflare Worker + D1/KV/R2 preview environments",
  "license": "MIT",
  "author": "BitByBit-B3",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "github-action",
    "cloudflare",
    "cloudflare-workers",
    "cloudflare-d1",
    "cloudflare-kv",
    "cloudflare-r2",
    "wrangler",
    "preview-environment",
    "ephemeral-environment",
    "pull-request",
    "ci-cd"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BitByBit-B3/cf-pr-preview-action.git"
  },
  "bugs": {
    "url": "https://github.com/BitByBit-B3/cf-pr-preview-action/issues"
  },
  "homepage": "https://github.com/BitByBit-B3/cf-pr-preview-action#readme",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-dist": "bun run build && git diff --exit-code -- dist/index.cjs",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "lefthook": "^1.10.0",
    "typescript": "^5.7.0"
  }
}
