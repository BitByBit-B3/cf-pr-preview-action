{
  "name": "cf-pr-preview-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action for per-PR ephemeral Cloudflare Worker + D1/KV/R2 preview environments",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check-dist": "bun run build && git diff --exit-code -- dist/index.cjs"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
